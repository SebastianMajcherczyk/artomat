<IfModule mod_rewrite.c>

  RewriteEngine On
  RewriteBase /

  # Apache samo przekierowuje /gallery -> /gallery/ (mod_dir), ale na tym
  # hostingu SSL jest terminowany przed Apache, więc w tym momencie serwer
  # "myśli", że żądanie jest po HTTP i buduje ten redirect jako
  # http://loftprint.pl/gallery/ zamiast https://. Efekt: /gallery, /technika,
  # /ceny i /druk-scienny-krakow (adresy dokładnie takie jak w sitemap.xml,
  # bez końcowego /) przechodziły przez podwójny redirect (https -> http ->
  # https zamiast prosto), co Google Search Console zgłaszało jako błąd
  # przekierowania.
  #
  # Próbowaliśmy to naprawić przez "DirectorySlash Off" (serwowanie katalogu
  # bez przekierowania) — na TYM hostingu skutkowało to 403 Forbidden na
  # każdej z tych stron zamiast poprawnego 200, więc cofnięte.
  #
  # Fix poniżej: własna reguła, która dokleja "/" do katalogu SAMA, zanim
  # zdąży to zrobić wbudowany mod_dir. Odpala się już PO regule HTTP->HTTPS
  # wyżej, więc jeśli do niej doszliśmy, %{HTTPS} w mod_rewrite już poprawnie
  # uznał żądanie za https (ta reguła wyżej realnie działa, bez pętli) -
  # można więc bezpiecznie zbudować cel jako https:// wprost, bez pytania
  # mod_dir o zdanie. Jeden redirect zamiast dwóch, bez przechodzenia przez
  # http po drodze.

  # Przekierowanie z wersji www do wersji bez www
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Przekierowanie z HTTP do HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^loftprint\.pl$ [NC]
  RewriteRule ^(.*)$ https://loftprint.pl/$1 [R=301,L]

  # Własny redirect katalog -> katalog/ (patrz komentarz wyżej) - wyprzedza
  # mod_dir, zanim ten zbuduje go błędnie jako http://
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # Istniejące reguły
  RewriteRule ^index\.html$ - [L]

  # Stare, realne adresy sprzed refaktoru na kotwice strony głównej
  # (czerwiec 2026) — menu kiedyś linkowało bezpośrednio do /kontakt,
  # /dla-kogo, /visualizer, ale te sekcje nigdy nie miały własnej
  # podstrony, więc te adresy teraz 404-ują (np. sitelinki Google Ads
  # wciąż na nie wskazują). Przekierowujemy 301 na właściwą kotwicę
  # strony głównej zamiast zwracać błąd.
  #
  # /inspiracje NIE jest tu już przekierowywane (październik 2026) — od tej
  # wersji to realna podstrona (InspiracjePage.jsx / "Grafika na ścianę"),
  # więc musi dojść do właściwego pliku zamiast być przechwycona przez tę
  # regułę przed dotarciem do prerenderowanego HTML-a.
  RewriteRule ^kontakt/?$ /\#kontakt [R=301,NE,L]
  RewriteRule ^dla-kogo/?$ /\#dla-kogo [R=301,NE,L]
  RewriteRule ^visualizer/?$ /\#visualizer [R=301,NE,L]

  # Strona jest teraz prerenderowana (scripts/prerender.js) — każda realna
  # trasa (/, /home, /technika, /ceny, /gallery, /druk-scienny-krakow) ma już
  # własny plik na dysku, więc trafi tu tylko naprawdę nieistniejący adres.
  # Serwujemy dla niego prawdziwe 404 zamiast dawnego cichego przepisania na
  # /index.html (Google Search Console traktuje to jako błąd "miękkiego 404").
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  ErrorDocument 404 /404.html
  RewriteRule . - [R=404,L]

</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # HTML zawsze świeży — po każdym wdrożeniu wskazuje na nowe, zahashowane
  # pliki JS/CSS; gdyby przeglądarka trzymała stary HTML z cache'a, mogłaby
  # próbować wczytać pliki, których już nie ma.
  ExpiresByType text/html "access plus 0 seconds"

  # JS/CSS z build/static/ mają w nazwie hash treści (webpack) — ten sam
  # adres zawsze ma tę samą zawartość, więc można cache'ować bezpiecznie na
  # bardzo długo.
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"

  # Obrazy i wideo: część ma hash w nazwie (webpack), część nie (zdjęcia z
  # public/, które czasem podmieniasz pod tą samą nazwą) — krótszy, bezpieczny
  # czas, żeby podmiana zdjęcia dotarła do użytkowników w rozsądnym terminie.
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/x-icon "access plus 1 week"
  ExpiresByType video/mp4 "access plus 1 week"
</IfModule>
